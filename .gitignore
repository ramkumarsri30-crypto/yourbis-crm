# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files — never commit real environment files; the example file is safe to track
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sandbox tooling (pre-existing before project creation)
skills/
download/
upload/

# local agent worklog (internal bookkeeping, not part of the product)
worklog.md

# bun (sandbox tool ran bun install once; this project uses npm)
bun.lock
bun.lockb
