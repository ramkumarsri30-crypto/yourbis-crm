# ──────────────────────────────────────────────────────────────────────
# CRM Workspace — environment variable template
#
# Copy this file to `.env.local` for local development and fill in the
# values for the phase you are working on. Never commit real environment
# files: `.gitignore` excludes `.env*` (this example file is the only
# tracked exception).
#
# Current status: Phase 1 runs with NO variables configured. The
# placeholders below become relevant in later phases (see
# docs/PHASE_ROADMAP.md).
# ──────────────────────────────────────────────────────────────────────

# ── Supabase (Phase 2: authentication · Phase 3+: database) ───────────
# Public values: safe to reference from browser code.
# Find them in your Supabase project under Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase service role (SERVER-ONLY SECRET) ────────────────────────
# ⚠️ Bypasses Row Level Security. Must ONLY be used in trusted
# server-side code (migrations, webhooks, admin jobs). Never prefix
# with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend — transactional email (Phase 9) ────────────────────────────
# ⚠️ SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Verified sender identity configured in Resend.
RESEND_FROM_EMAIL=
